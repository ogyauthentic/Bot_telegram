# ── Salin jadi .env dan isi ────────────────────────────────────────────────
# cp .env.example .env

# Token dari @BotFather
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL domain HTTPS kamu
WEBHOOK_URL=https://pandawa.example.com

# Path webhook rahasia — hasilkan dengan: openssl rand -hex 20
SECRET_PATH=ganti_string_acak_panjang_di_sini

# Port Flask (jangan ubah jika pakai Nginx)
PORT=5000

# Telegram User ID admin (pisah koma jika lebih dari satu)
# Cara cek ID: hubungi @userinfobot
ADMIN_IDS=111111111,222222222

# Chat ID grup/channel admin untuk notifikasi pesanan masuk
# Cara cek: tambahkan bot ke grup, lalu lihat update via /getUpdates
ADMIN_GROUP_ID=0
